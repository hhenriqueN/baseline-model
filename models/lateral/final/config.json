{
  "network": "lateral",
  "architecture": {
    "class": "LateralMLP",
    "n_inputs": 11,
    "n_hidden": 64,
    "n_outputs": 2,
    "layers": [
      "Linear(11,64)",
      "SiLU",
      "Linear(64,64)",
      "SiLU",
      "Linear(64,2)"
    ],
    "output_activation": [
      "linear",
      "linear"
    ],
    "batch_norm": false,
    "dropout": false
  },
  "feature_order": [
    "along_track_m",
    "cross_track_error_m",
    "heading_error_sin",
    "heading_error_cos",
    "agl_ft",
    "roll_deg",
    "sideslip_rad",
    "roll_rate_degps",
    "yaw_rate_degps",
    "airspeed_kt",
    "lateral_body_speed_fps"
  ],
  "label_order": [
    "aileron_command",
    "rudder_command"
  ],
  "training_config": {
    "seed": 42,
